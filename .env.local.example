# ─── Clerk Authentication ───────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com after creating an app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Piston Sandbox (server-side only — never NEXT_PUBLIC_) ─────────────────
# Default: public emkc.org endpoint (whitelist-only since Feb 2026 — may need key)
PISTON_URL=https://emkc.org/api/v2/piston/execute
PISTON_KEY=

# Self-hosted Piston example (docker run -d -p 2000:2000 ghcr.io/engineer-man/piston):
# PISTON_URL=http://localhost:2000/api/v2/execute
# PISTON_KEY=

# ─── Supabase (Cross-device data synchronization) ───────────────────────────
# Create a project at https://supabase.com
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...